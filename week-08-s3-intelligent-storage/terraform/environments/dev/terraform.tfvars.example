# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

project     = "week-08-s3-storage"
environment = "dev"
aws_region  = "us-east-1"

# Email address that receives the daily storage cost report.
# After deploy, confirm the SNS subscription from the email AWS sends you.
sns_email = "your-email@example.com"

# Intelligent-Tiering archive thresholds (days of inactivity)
intelligent_tiering_archive_days      = 90
intelligent_tiering_deep_archive_days = 180

# Lifecycle policy for logs/ prefix
logs_ia_transition_days            = 30
logs_glacier_transition_days       = 90
logs_expiration_days               = 365
noncurrent_version_expiration_days = 30
