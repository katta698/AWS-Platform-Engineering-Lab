# Lambda
lambda/**/__pycache__/
lambda/**/*.pyc
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Lambda zips ARE committed here (not gitignored like other weeks) — this
# workspace is HCP/VCS-driven, not local CLI, so the remote run needs the
# built zips checked into the repo rather than built by scripts/deploy.sh
# right before a local terraform apply.

