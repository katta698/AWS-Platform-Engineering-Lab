aws_region  = "us-east-1"
name_prefix = "week12-cfgcompliance"

# Set in HCP as a sensitive workspace variable, not here.
# alert_email = "you@example.com"

remediation_tag_key   = "auto-remediate"
remediation_tag_value = "true"
required_tag_keys     = ["environment", "owner", "cost-center"]
log_retention_days    = 30
