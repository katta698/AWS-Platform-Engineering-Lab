# Copy this file to .servicenow.env (repo root) and fill in real values.
# .servicenow.env is gitignored — never commit it.
#
# Read by scripts/servicenow/*.py for every week that wires up ServiceNow
# (Outbound REST Message, Catalog Item, Business Rule) via the Table API,
# instead of clicking through the ServiceNow UI by hand each time.

SNOW_INSTANCE=devXXXXXX
SNOW_USERNAME=your-servicenow-admin-or-service-account
SNOW_PASSWORD=your-servicenow-password
