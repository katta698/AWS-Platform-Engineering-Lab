# Copy to terraform.tfvars and fill in real values
# NEVER commit terraform.tfvars to source control

project     = "selfservice-ec2"
environment = "dev"
aws_region  = "us-east-1"
cost_center = "platform-engineering"

vpc_cidr             = "10.0.0.0/16"
app_port             = 8080
instance_type        = "t3.medium"
asg_min_size         = 1
asg_max_size         = 4
asg_desired_capacity = 2

acm_certificate_arn  = "arn:aws:acm:us-east-1:123456789012:certificate/xxxx"
access_logs_bucket   = "my-company-alb-logs"
artifact_bucket_name = "my-company-artifacts"
tf_state_bucket      = "my-company-tf-state"
tf_lock_table        = "terraform-lock"

github_org  = "my-github-org"
github_repo = "selfservice-ec2-provisioning"

alert_emails = ["platform-team@company.com", "oncall@company.com"]
